# Copiez ce fichier en `.env` et adaptez les valeurs.
# VITE_ est le préfixe requis par Vite pour exposer une variable au client.

# Supabase
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# URL publique de déploiement (origine des liens email Supabase Auth :
# confirmation d'inscription / réinitialisation de mot de passe).
# À définir en production (ex. https://ntc-assessment-center-moteur-scorin.vercel.app)
VITE_PUBLIC_SITE_URL=